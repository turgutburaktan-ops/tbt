rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function safeUserCreate(uid) {
      return isSelf(uid) && request.resource.data.uid == uid &&
        !request.resource.data.keys().hasAny([
          'admin','isAdmin','role','roles','claims','permissions',
          'verified','verificationStatus','businessVerified','venueVerified',
          'moderationStatus','trustLevel','banned','disabled'
        ]);
    }
    function safeUserUpdate(uid) {
      return isSelf(uid) && (!('uid' in request.resource.data) || request.resource.data.uid == uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid','admin','isAdmin','role','roles','claims','permissions',
          'verified','verificationStatus','businessVerified','venueVerified',
          'moderationStatus','trustLevel','banned','disabled'
        ]);
    }
    function eventVisible(d) {
      return !('visibility' in d) || d.visibility == 'public' || (signedIn() && (
        d.hostId == request.auth.uid ||
        (('participantIds' in d) && d.participantIds.hasAny([request.auth.uid])) ||
        (('allowedUserIds' in d) && d.allowedUserIds.hasAny([request.auth.uid]))
      ));
    }
    function memoryVisible(d) {
      let id = d.eventId;
      return exists(/databases/$(database)/documents/social_events/$(id)) &&
        eventVisible(get(/databases/$(database)/documents/social_events/$(id)).data);
    }
    function validCommunityHost() {
      let id = request.resource.data.get('communityId', null);
      return id == null || id == '' || (signedIn() &&
        exists(/databases/$(database)/documents/communities/$(id)) &&
        get(/databases/$(database)/documents/communities/$(id)).data.adminIds.hasAny([request.auth.uid]));
    }
    function paidCreateValid() {
      return request.resource.data.accessType != 'paid' || (
        request.resource.data.paymentStatus == 'comingSoon' &&
        request.resource.data.trustStatus == 'pending_review' &&
        request.resource.data.salesStatus == 'blocked' &&
        request.resource.data.paymentReleaseStatus == 'held' &&
        request.resource.data.reportCount == 0 &&
        request.resource.data.riskLevel in ['low','medium'] &&
        request.resource.data.ticketPriceMinor > 0
      );
    }
    function privacyValid() {
      return !('visibility' in request.resource.data) ||
        request.resource.data.visibility in ['public','followers','mutuals','closeFriends','selectedPeople','private'];
    }
    function protectedEventFieldsSame() {
      return request.resource.data.hostId == resource.data.hostId &&
        request.resource.data.get('communityId', null) == resource.data.get('communityId', null) &&
        request.resource.data.get('communityName', null) == resource.data.get('communityName', null) &&
        request.resource.data.accessType == resource.data.accessType &&
        request.resource.data.ticketPriceMinor == resource.data.ticketPriceMinor &&
        request.resource.data.currency == resource.data.currency &&
        request.resource.data.trustStatus == resource.data.trustStatus &&
        request.resource.data.salesStatus == resource.data.salesStatus &&
        request.resource.data.riskLevel == resource.data.riskLevel &&
        request.resource.data.reportCount == resource.data.reportCount &&
        request.resource.data.paymentStatus == resource.data.paymentStatus &&
        request.resource.data.paymentReleaseStatus == resource.data.paymentReleaseStatus &&
        request.resource.data.paymentProvider == resource.data.paymentProvider &&
        request.resource.data.externalProductId == resource.data.externalProductId;
    }
    function participantOnlyChange() {
      let old = resource.data.participantIds;
      let next = request.resource.data.participantIds;
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return signedIn() && changed.hasOnly(['participantIds','updatedAt']) && (
        (next.size() == old.size() + 1 && next.hasAll(old) && next.hasAny([request.auth.uid])) ||
        (old.size() == next.size() + 1 && old.hasAll(next) && old.hasAny([request.auth.uid]) && !next.hasAny([request.auth.uid]))
      );
    }
    function validMemoryCreate() {
      let id = request.resource.data.eventId;
      return signedIn() && request.resource.data.userId == request.auth.uid &&
        exists(/databases/$(database)/documents/social_events/$(id)) &&
        get(/databases/$(database)/documents/social_events/$(id)).data.participantIds.hasAny([request.auth.uid]) &&
        get(/databases/$(database)/documents/social_events/$(id)).data.startsAt <= request.time &&
        get(/databases/$(database)/documents/social_events/$(id)).data.status != 'cancelled';
    }
    function validEventMemoryPost() {
      let id = request.resource.data.get('eventId', null);
      return id == null || id == '' || (
        exists(/databases/$(database)/documents/social_events/$(id)) &&
        get(/databases/$(database)/documents/social_events/$(id)).data.visibility == 'public' &&
        get(/databases/$(database)/documents/social_events/$(id)).data.participantIds.hasAny([request.auth.uid]) &&
        get(/databases/$(database)/documents/social_events/$(id)).data.startsAt <= request.time &&
        get(/databases/$(database)/documents/social_events/$(id)).data.status != 'cancelled'
      );
    }
    function blockedBetween(otherUid) {
      return signedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked/$(otherUid)) ||
        exists(/databases/$(database)/documents/users/$(otherUid)/blocked/$(request.auth.uid))
      );
    }
    function validDirectThreadCreate() {
      let members = request.resource.data.memberIds;
      let other = members[0] == request.auth.uid ? members[1] : members[0];
      return signedIn() && request.resource.data.type == 'direct' &&
        members.size() == 2 && members[0] != members[1] &&
        members.hasAny([request.auth.uid]) && !blockedBetween(other);
    }
    function threadMember(id) {
      return signedIn() && exists(/databases/$(database)/documents/chat_threads/$(id)) &&
        get(/databases/$(database)/documents/chat_threads/$(id)).data.memberIds.hasAny([request.auth.uid]);
    }
    function threadUnblocked(id) {
      let members = get(/databases/$(database)/documents/chat_threads/$(id)).data.memberIds;
      let other = members[0] == request.auth.uid ? members[1] : members[0];
      return members.size() == 2 && !blockedBetween(other);
    }
    function validStoryInteraction(storyId, uid) {
      let story = get(/databases/$(database)/documents/stories/$(storyId)).data;
      return signedIn() && uid == request.auth.uid && story.userId != uid && story.expiresAt > request.time &&
        request.resource.data.userId == uid &&
        request.resource.data.keys().hasOnly(['userId','userName','userPhotoUrl','viewedAt','updatedAt','liked','reaction','message','messageAt']) &&
        request.resource.data.get('userName', '') is string && request.resource.data.get('userName', '').size() <= 120 &&
        request.resource.data.get('userPhotoUrl', '') is string && request.resource.data.get('userPhotoUrl', '').size() <= 1200 &&
        request.resource.data.get('reaction', '') is string && request.resource.data.get('reaction', '').size() <= 8 &&
        request.resource.data.get('message', '') is string && request.resource.data.get('message', '').size() <= 500;
    }
    function validPostCreate() {
      return signedIn() && request.resource.data.userId == request.auth.uid && validEventMemoryPost() &&
        request.resource.data.get('caption', '') is string && request.resource.data.get('caption', '').size() <= 500 &&
        request.resource.data.get('spotName', '') is string && request.resource.data.get('spotName', '').size() <= 120 &&
        request.resource.data.get('mediaType', 'image') in ['image','video'] &&
        request.resource.data.get('durationMs', 0) is int && request.resource.data.get('durationMs', 0) >= 0 && request.resource.data.get('durationMs', 0) <= 60000 &&
        request.resource.data.get('sourceType', 'post') in ['post','event_memory'];
    }
    function validBusinessPost() {
      let key = request.resource.data.get('businessVenueKey', '');
      let name = request.resource.data.get('businessVenueName', '');
      let official = request.resource.data.get('businessOfficial', false);
      return key == '' || (
        key is string && key.size() <= 240 &&
        name is string && name.size() <= 160 &&
        official is bool &&
        (!official || (
          exists(/databases/$(database)/documents/business_venues/$(key)) &&
          get(/databases/$(database)/documents/business_venues/$(key)).data.verified == true &&
          get(/databases/$(database)/documents/business_venues/$(key)).data.ownerUid == request.auth.uid
        ))
      );
    }
    function validPostOwnerUpdate() {
      return signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption','spotName','updatedAt']) &&
        request.resource.data.get('caption', '') is string && request.resource.data.get('caption', '').size() <= 500 &&
        request.resource.data.get('spotName', '') is string && request.resource.data.get('spotName', '').size() <= 120;
    }
    function eventAttendancePath(eventId) {
      return /databases/$(database)/documents/social_events/$(eventId)/attendance/$(request.auth.uid);
    }
    function oldAttendanceStatus(eventId) {
      return exists(eventAttendancePath(eventId)) ? get(eventAttendancePath(eventId)).data.status : 'none';
    }
    function newAttendanceStatus(eventId) {
      return existsAfter(eventAttendancePath(eventId)) ? getAfter(eventAttendancePath(eventId)).data.status : 'none';
    }
    function validMembershipDelta(eventId) {
      let oldStatus = oldAttendanceStatus(eventId);
      let nextStatus = newAttendanceStatus(eventId);
      let oldGoing = oldStatus == 'going';
      let nextGoing = nextStatus == 'going';
      let oldIds = resource.data.participantIds;
      let nextIds = request.resource.data.participantIds;
      return (oldGoing == nextGoing && nextIds == oldIds) ||
        (!oldGoing && nextGoing && nextIds.size() == oldIds.size() + 1 && nextIds.hasAll(oldIds) && nextIds.hasAny([request.auth.uid])) ||
        (oldGoing && !nextGoing && oldIds.size() == nextIds.size() + 1 && oldIds.hasAll(nextIds) && oldIds.hasAny([request.auth.uid]) && !nextIds.hasAny([request.auth.uid]));
    }
    function validAttendanceCounters(eventId) {
      let oldStatus = oldAttendanceStatus(eventId);
      let nextStatus = newAttendanceStatus(eventId);
      let oldInterested = resource.data.get('interestedCount', 0);
      let nextInterested = request.resource.data.get('interestedCount', 0);
      let oldPrivate = resource.data.get('privateParticipantCount', 0);
      let nextPrivate = request.resource.data.get('privateParticipantCount', 0);
      let interestedDelta = (nextStatus == 'interested' ? 1 : 0) - (oldStatus == 'interested' ? 1 : 0);
      let privateDelta = (nextStatus == 'private' ? 1 : 0) - (oldStatus == 'private' ? 1 : 0);
      return nextInterested == oldInterested + interestedDelta && nextPrivate == oldPrivate + privateDelta && nextInterested >= 0 && nextPrivate >= 0;
    }
    function validAttendanceEventUpdate(eventId) {
      let nextStatus = newAttendanceStatus(eventId);
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let capacity = request.resource.data.get('capacity', 1);
      return signedIn() && resource.data.hostId != request.auth.uid && resource.data.status == 'open' &&
        nextStatus in ['going','interested','private','none'] &&
        changed.hasOnly(['participantIds','interestedCount','privateParticipantCount','updatedAt']) &&
        validMembershipDelta(eventId) && validAttendanceCounters(eventId) &&
        request.resource.data.participantIds.size() + request.resource.data.get('privateParticipantCount', 0) <= capacity;
    }
    function validCommentCreate() {
      return signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.text is string &&
        request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 700;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if safeUserCreate(uid);
      allow update: if isAdmin() || safeUserUpdate(uid);
      allow delete: if isAdmin() || isSelf(uid);
      match /following/{targetId} { allow read: if signedIn(); allow create, update: if isSelf(uid) && request.resource.data.userId == targetId; allow delete: if isSelf(uid); }
      match /followers/{followerId} { allow read: if signedIn(); allow create, update: if signedIn() && followerId == request.auth.uid && request.resource.data.userId == request.auth.uid; allow delete: if signedIn() && followerId == request.auth.uid; }
      match /blocked/{blockedId} { allow read: if signedIn() && (uid == request.auth.uid || blockedId == request.auth.uid); allow create, update, delete: if isSelf(uid); }
      match /close_friends/{friendId} { allow read, create, update, delete: if isSelf(uid); }
      match /notifications/{notificationId} {
        allow read, update, delete: if isSelf(uid);
        allow create: if signedIn() && request.resource.data.keys().hasAll(['type','title','body','actorId']) &&
          request.resource.data.type is string && request.resource.data.title is string && request.resource.data.body is string &&
          request.resource.data.actorId == request.auth.uid && request.resource.data.title.size() > 0 &&
          request.resource.data.title.size() <= 160 && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 600;
      }
      match /push_tokens/{tokenId} {
        allow read: if isAdmin() || isSelf(uid);
        allow create, update: if isSelf(uid) && request.resource.data.keys().hasAll(['token']) &&
          request.resource.data.token is string && request.resource.data.token.size() >= 20 && request.resource.data.token.size() <= 4096;
        allow delete: if isSelf(uid);
      }
      match /map_points/{pointId} { allow read, create, update, delete: if isSelf(uid) && (request.method == 'delete' || request.resource.data.ownerId == uid); }
    }

    match /usernames/{usernameId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.normalized == usernameId && request.resource.data.username is string;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == resource.data.uid && request.resource.data.normalized == usernameId;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /chat_threads/{threadId} {
      // A deterministic DM id is checked before its document exists. Permit
      // that empty get, while keeping existing threads private to members.
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/chat_threads/$(threadId)) ||
        resource.data.memberIds.hasAny([request.auth.uid])
      );
      allow list: if signedIn() && resource.data.memberIds.hasAny([request.auth.uid]);
      allow create: if validDirectThreadCreate();
      allow update: if signedIn() && resource.data.memberIds.hasAny([request.auth.uid]) && request.resource.data.memberIds == resource.data.memberIds && request.resource.data.type == resource.data.type && threadUnblocked(threadId);
      allow delete: if false;
      match /messages/{messageId} { allow read: if threadMember(threadId); allow create: if threadMember(threadId) && threadUnblocked(threadId) && request.resource.data.senderId == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1500 && request.resource.data.deleted == false; allow update, delete: if false; }
    }
    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.expiresAt > request.time;
      allow update: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      match /interactions/{uid} { allow read: if signedIn() && (uid == request.auth.uid || get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid); allow create, update: if validStoryInteraction(storyId, uid); allow delete: if signedIn() && uid == request.auth.uid; }
    }
    match /social_events/{eventId} {
      allow read: if eventVisible(resource.data);
      allow create: if signedIn() && request.resource.data.hostId == request.auth.uid && request.resource.data.status == 'open' && paidCreateValid() && privacyValid() && validCommunityHost();
      allow update: if isAdmin() || validAttendanceEventUpdate(eventId) || (signedIn() && resource.data.hostId == request.auth.uid && protectedEventFieldsSame() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && request.resource.data.status in ['open','cancelled']);
      allow delete: if isAdmin();
      match /attendance/{uid} { allow read: if signedIn() && eventVisible(get(/databases/$(database)/documents/social_events/$(eventId)).data); allow create, update: if isSelf(uid) && request.resource.data.userId == uid && request.resource.data.status in ['going','interested','private'] && get(/databases/$(database)/documents/social_events/$(eventId)).data.hostId != uid && get(/databases/$(database)/documents/social_events/$(eventId)).data.status == 'open'; allow delete: if isSelf(uid); }
      match /reports/{reporterId} { allow read: if isAdmin(); allow create: if signedIn() && reporterId == request.auth.uid && request.resource.data.reporterId == request.auth.uid && request.resource.data.reason is string && request.resource.data.reason.size() >= 3 && request.resource.data.reason.size() <= 300; allow update, delete: if false; }
      match /likes/{uid} { allow read: if eventVisible(get(/databases/$(database)/documents/social_events/$(eventId)).data); allow create: if isSelf(uid) && request.resource.data.userId == uid; allow delete: if isSelf(uid); allow update: if false; }
      match /comments/{commentId} { allow read: if eventVisible(get(/databases/$(database)/documents/social_events/$(eventId)).data); allow create: if validCommentCreate(); allow update, delete: if signedIn() && resource.data.userId == request.auth.uid; }
      match /tags/{taggedUserId} { allow read: if eventVisible(get(/databases/$(database)/documents/social_events/$(eventId)).data); allow create: if signedIn() && request.resource.data.userId == taggedUserId && request.resource.data.taggedBy == request.auth.uid; allow update, delete: if signedIn() && resource.data.taggedBy == request.auth.uid; }
      match /{sub}/{docId} { allow read, write: if false; }
    }
    match /event_memories/{memoryId} {
      allow read: if memoryVisible(resource.data); allow create: if validMemoryCreate(); allow update, delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      match /likes/{uid} { allow read: if memoryVisible(get(/databases/$(database)/documents/event_memories/$(memoryId)).data); allow create: if isSelf(uid) && request.resource.data.userId == uid; allow delete: if isSelf(uid); allow update: if false; }
      match /comments/{commentId} { allow read: if memoryVisible(get(/databases/$(database)/documents/event_memories/$(memoryId)).data); allow create: if validCommentCreate() && memoryVisible(get(/databases/$(database)/documents/event_memories/$(memoryId)).data); allow update, delete: if signedIn() && resource.data.userId == request.auth.uid; }
      match /tags/{taggedUserId} { allow read: if memoryVisible(get(/databases/$(database)/documents/event_memories/$(memoryId)).data); allow create: if signedIn() && request.resource.data.userId == taggedUserId && request.resource.data.taggedBy == request.auth.uid; allow update, delete: if signedIn() && resource.data.taggedBy == request.auth.uid; }
      match /{sub}/{docId} { allow read, write: if false; }
    }
    match /posts/{postId} {
      allow read: if true;
      allow create: if validPostCreate() && validBusinessPost();
      allow update: if isAdmin() || validPostOwnerUpdate();
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      match /likes/{uid} { allow read: if true; allow create: if isSelf(uid) && request.resource.data.userId == uid; allow delete: if isSelf(uid); allow update: if false; }
      match /comments/{commentId} { allow read: if true; allow create: if validCommentCreate(); allow update, delete: if signedIn() && resource.data.userId == request.auth.uid; }
      match /tags/{taggedUserId} { allow read: if true; allow create: if signedIn() && request.resource.data.userId == taggedUserId && request.resource.data.taggedBy == request.auth.uid; allow update, delete: if signedIn() && resource.data.taggedBy == request.auth.uid; }
      match /{sub}/{docId} { allow read, write: if false; }
    }
    match /business_venues/{venueKey} {
      allow read: if true;
      allow create, update, delete: if false;
      match /menu/{itemId} { allow read: if true; allow write: if false; }
      match /program/{itemId} { allow read: if true; allow write: if false; }
      match /campaigns/{itemId} { allow read: if true; allow write: if false; }
      match /trust_reports/{reportId} { allow read, write: if false; }
      match /{sub}/{docId} { allow read, write: if false; }
    }
    match /spot_presence/{id} { allow read: if signedIn(); allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow update, delete: if signedIn() && resource.data.userId == request.auth.uid; }
    match /spot_meetups/{id} { allow read: if true; allow create: if signedIn() && request.resource.data.hostId == request.auth.uid && request.resource.data.participantIds.hasAny([request.auth.uid]); allow update: if signedIn() && (participantOnlyChange() || (resource.data.hostId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && request.resource.data.status in ['open','cancelled'])); allow delete: if isAdmin(); }
    match /event_tickets/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || (exists(/databases/$(database)/documents/social_events/$(resource.data.eventId)) && get(/databases/$(database)/documents/social_events/$(resource.data.eventId)).data.hostId == request.auth.uid));
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && exists(/databases/$(database)/documents/social_events/$(request.resource.data.eventId)) && request.resource.data.status in ['active','pendingPayment'] && ((get(/databases/$(database)/documents/social_events/$(request.resource.data.eventId)).data.get('accessType', 'free') == 'free' && request.resource.data.status == 'active') || (get(/databases/$(database)/documents/social_events/$(request.resource.data.eventId)).data.get('accessType', 'free') == 'paid' && request.resource.data.status == 'pendingPayment'));
      allow update: if signedIn() && (
        (resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.eventId == resource.data.eventId &&
          request.resource.data.status in ['active','pendingPayment','cancelled'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eventTitle','userName','status','isPaidEvent','priceMinor','currency','qrToken','issuedAt','usedAt','updatedAt']) &&
          exists(/databases/$(database)/documents/social_events/$(resource.data.eventId)) &&
          ((get(/databases/$(database)/documents/social_events/$(resource.data.eventId)).data.get('accessType', 'free') == 'free' && request.resource.data.status in ['active','cancelled']) ||
           (get(/databases/$(database)/documents/social_events/$(resource.data.eventId)).data.get('accessType', 'free') == 'paid' && request.resource.data.status in ['pendingPayment','cancelled']))) ||
        (exists(/databases/$(database)/documents/social_events/$(resource.data.eventId)) &&
          get(/databases/$(database)/documents/social_events/$(resource.data.eventId)).data.hostId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','usedAt','updatedAt']) &&
          request.resource.data.status == 'used')
      );
      allow delete: if isAdmin();
    }
    match /user_reports/{id} { allow read: if isAdmin(); allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid && request.resource.data.reportedUserId is string && request.resource.data.reason is string && request.resource.data.reason.size() >= 3 && request.resource.data.reason.size() <= 500; allow update, delete: if isAdmin(); }
    match /activity_demands/{id} { allow read: if true; allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid; allow delete: if signedIn() && resource.data.userId == request.auth.uid; }
    match /communities/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && request.resource.data.verified == false && request.resource.data.verificationStatus == 'pending' && request.resource.data.adminIds.hasAny([request.auth.uid]);
      allow update: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.verified == resource.data.verified && request.resource.data.verificationStatus == resource.data.verificationStatus);
      allow delete: if isAdmin();
      match /followers/{uid} { allow read: if true; allow create, update: if signedIn() && uid == request.auth.uid && request.resource.data.userId == request.auth.uid; allow delete: if signedIn() && uid == request.auth.uid; }
    }
    match /photo_spots/{id} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /spot_submissions/{id} { allow read: if isAdmin() || (signedIn() && resource.data.submittedBy == request.auth.uid); allow create: if signedIn() && request.resource.data.submittedBy == request.auth.uid && request.resource.data.status == 'pending' && request.resource.data.coordinateVerified == false && request.resource.data.imageVerified == false && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 120; allow update, delete: if isAdmin(); }
    match /map_point_suggestions/{id} { allow read: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid); allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && request.resource.data.communitySuggested == true && request.resource.data.moderationStatus == 'pending' && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60; allow update, delete: if isAdmin(); }
    match /venue_ratings/{venueKey} {
      allow read: if true; allow create, update, delete: if false;
      match /ratings/{uid} {
        allow read: if true; allow create, update: if isSelf(uid) && request.resource.data.userId == uid && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 && request.resource.data.get('comment', '') is string && request.resource.data.get('comment', '').size() <= 700 && request.resource.data.get('moderationStatus', 'published') == 'published'; allow delete: if isSelf(uid) || isAdmin();
        match /helpful/{voterId} { allow read: if true; allow create: if signedIn() && voterId == request.auth.uid && voterId != uid && request.resource.data.userId == request.auth.uid; allow delete: if signedIn() && voterId == request.auth.uid; allow update: if false; }
        match /{sub}/{docId} { allow read, write: if false; }
      }
    }
    match /review_reports/{id} { allow read: if isAdmin(); allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid && request.resource.data.reviewUserId != request.auth.uid && request.resource.data.status == 'pending' && request.resource.data.reason is string && request.resource.data.reason.size() >= 3 && request.resource.data.reason.size() <= 120; allow update, delete: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
