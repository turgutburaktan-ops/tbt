rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    function eventVisible(data) {
      return !('visibility' in data)
        || data.visibility == 'public'
        || (signedIn() && (
          data.hostId == request.auth.uid
          || (('participantIds' in data) && data.participantIds.hasAny([request.auth.uid]))
          || (('allowedUserIds' in data) && data.allowedUserIds.hasAny([request.auth.uid]))
        ));
    }

    function validCommunityHostCreate() {
      let cid = request.resource.data.get('communityId', null);
      return cid == null
        || cid == ''
        || (
          signedIn()
          && exists(/databases/$(database)/documents/communities/$(cid))
          && get(/databases/$(database)/documents/communities/$(cid)).data.adminIds.hasAny([request.auth.uid])
        );
    }

    function protectedEventFieldsUnchanged() {
      return request.resource.data.hostId == resource.data.hostId
        && request.resource.data.get('communityId', null) == resource.data.get('communityId', null)
        && request.resource.data.get('communityName', null) == resource.data.get('communityName', null)
        && request.resource.data.accessType == resource.data.accessType
        && request.resource.data.ticketPriceMinor == resource.data.ticketPriceMinor
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.trustStatus == resource.data.trustStatus
        && request.resource.data.salesStatus == resource.data.salesStatus
        && request.resource.data.riskLevel == resource.data.riskLevel
        && request.resource.data.reportCount == resource.data.reportCount
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.paymentReleaseStatus == resource.data.paymentReleaseStatus
        && request.resource.data.paymentProvider == resource.data.paymentProvider
        && request.resource.data.externalProductId == resource.data.externalProductId;
    }

    function validPaidCreate() {
      return request.resource.data.accessType != 'paid' || (
        request.resource.data.paymentStatus == 'comingSoon'
        && request.resource.data.trustStatus == 'pending_review'
        && request.resource.data.salesStatus == 'blocked'
        && request.resource.data.paymentReleaseStatus == 'held'
        && request.resource.data.reportCount == 0
        && request.resource.data.riskLevel in ['low', 'medium']
        && request.resource.data.ticketPriceMinor > 0
      );
    }

    function validPrivacyCreate() {
      return !('visibility' in request.resource.data)
        || request.resource.data.visibility in ['public','followers','mutuals','closeFriends','selectedPeople','private'];
    }

    function participantJoinOrLeaveOnly() {
      let oldList = resource.data.participantIds;
      let newList = request.resource.data.participantIds;
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['participantIds','updatedAt']) && (
        (newList.size() == oldList.size() + 1 && newList.hasAll(oldList) && newList.hasAny([request.auth.uid]))
        || (oldList.size() == newList.size() + 1 && oldList.hasAll(newList) && oldList.hasAny([request.auth.uid]) && !newList.hasAny([request.auth.uid]))
      );
    }

    match /social_events/{eventId} {
      allow read: if eventVisible(resource.data);
      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.status == 'open'
        && validPaidCreate()
        && validPrivacyCreate()
        && validCommunityHostCreate();
      allow update: if isAdmin() || (signedIn() && eventVisible(resource.data) && protectedEventFieldsUnchanged() && (
        participantJoinOrLeaveOnly()
        || (resource.data.hostId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
          && request.resource.data.status in ['open','cancelled'])
      ));
      allow delete: if isAdmin();

      match /reports/{reporterId} {
        allow read: if isAdmin();
        allow create: if signedIn()
          && reporterId == request.auth.uid
          && request.resource.data.reporterId == request.auth.uid
          && request.resource.data.reason is string
          && request.resource.data.reason.size() >= 3;
        allow update, delete: if false;
      }
    }

    match /activity_demands/{demandId} {
      allow read: if true;
      allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /communities/{communityId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.verified == false
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.adminIds.hasAny([request.auth.uid]);
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.verified == resource.data.verified
        && request.resource.data.verificationStatus == resource.data.verificationStatus
      );
      allow delete: if isAdmin();

      match /followers/{userId} {
        allow read: if true;
        allow create, update: if signedIn()
          && userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;
        allow delete: if signedIn() && userId == request.auth.uid;
      }
    }

    match /{collection}/{document} {
      allow read: if collection != 'social_events';
      allow write: if signedIn()
        && collection != 'social_events'
        && collection != 'activity_demands'
        && collection != 'communities';
    }

    match /{collection}/{document}/{rest=**} {
      allow read: if collection != 'social_events';
      allow write: if signedIn()
        && collection != 'social_events'
        && collection != 'activity_demands'
        && collection != 'communities';
    }
  }
}
