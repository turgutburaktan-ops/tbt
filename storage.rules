rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function safeMediaWrite() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 50 * 1024 * 1024 &&
        request.resource.contentType != null &&
        request.resource.contentType.matches('^(image|video)/.*$');
    }

    // All user-generated media is namespaced by Firebase Auth uid.
    // Public reads preserve the existing feed/story/profile behavior, while
    // only the owning account can create, replace or delete its files.
    match /users/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isOwner(uid) && safeMediaWrite();
      allow delete: if isOwner(uid);
    }

    // No un-namespaced uploads are accepted.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
