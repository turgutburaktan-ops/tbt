rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /event_chat/{eventId}/{uid}/{messageId}/{fileName} {
      function eventChatParticipant() {
        let e = firestore.get(/databases/(default)/documents/social_events/$(eventId)).data;
        return request.auth != null && (e.hostId == request.auth.uid || e.participantIds.hasAny([request.auth.uid]));
      }
      function eventChatUpload() {
        return request.resource != null && request.resource.size > 0 &&
          ((fileName == 'audio.m4a' && request.resource.size <= 20*1024*1024 && request.resource.contentType == 'audio/mp4') ||
           (fileName.matches('media\\.(jpg|png|webp|heic|heif)') && request.resource.size <= 15*1024*1024 && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)')) ||
           (fileName.matches('media\\.(mp4|mov)') && request.resource.size <= 100*1024*1024 && request.resource.contentType.matches('video/(mp4|quicktime)')));
      }
      allow read: if eventChatParticipant();
      allow create: if resource == null && eventChatParticipant() && request.auth.uid == uid && firestore.get(/databases/(default)/documents/social_events/$(eventId)).data.status == 'open' && eventChatUpload();
      allow update: if false;
      allow delete: if eventChatParticipant() && request.auth.uid == uid;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function safeImageWrite() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 15 * 1024 * 1024 &&
        request.resource.contentType != null &&
        request.resource.contentType.matches('^image/(jpeg|png|webp|heic|heif)$');
    }

    function safeVideoWrite() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 100 * 1024 * 1024 &&
        request.resource.contentType != null &&
        request.resource.contentType.matches('^video/(mp4|quicktime)$');
    }

    function safeAudioWrite() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 20 * 1024 * 1024 &&
        request.resource.contentType != null &&
        request.resource.contentType.matches('^audio/(mp4|m4a|aac|mpeg|ogg|wav|x-m4a)$');
    }

    function safeMediaWrite() {
      return safeImageWrite() || safeVideoWrite() || safeAudioWrite();
    }

    // User media stays namespaced by Firebase Auth uid. This keeps existing
    // public feed/profile rendering intact. Private chat has its own policy below.
    match /users/{uid}/{category}/{allPaths=**} {
      allow read: if category != 'chat';
      allow create, update: if category != 'chat' && isOwner(uid) && safeMediaWrite();
      allow delete: if category != 'chat' && isOwner(uid);
    }
    // TBT authenticated chat media v1. Never grant this namespace public access.
    function chatMediaMember(threadId) {
      return signedIn() && firestore.get(/databases/(default)/documents/chat_threads/$(threadId)).data.memberIds.hasAny([request.auth.uid]);
    }
    function chatMediaReadable(threadId, uid, messageId) {
      let thread = firestore.get(/databases/(default)/documents/chat_threads/$(threadId)).data;
      let message = firestore.get(/databases/(default)/documents/chat_threads/$(threadId)/messages/$(messageId)).data;
      return thread.memberIds.hasAny([request.auth.uid]) &&
        message.senderId == uid && message.get('deleted', false) == false &&
        !thread.get('deletedMessageIds', []).hasAny([messageId]);
    }
    match /private_chat/{threadId}/{uid}/{messageId}/{fileName} {
      allow get: if signedIn() && resource.metadata.get('chatSealed', '') == 'true' &&
        chatMediaReadable(threadId, uid, messageId);
      allow list: if false;
      allow create: if isOwner(uid) && chatMediaMember(threadId) &&
        !firestore.exists(/databases/(default)/documents/chat_threads/$(threadId)/messages/$(messageId)) &&
        !request.resource.metadata.keys().hasAny(['chatSealed']) &&
        ((fileName.matches('media\\.(jpg|png|webp)') && safeImageWrite()) ||
         (fileName == 'audio.m4a' && safeAudioWrite() && request.resource.contentType == 'audio/mp4'));
      allow update: if false;
      allow delete: if isOwner(uid) && chatMediaMember(threadId);
    }
    match /users/{uid}/chat/{threadId}/{fileName} {
      allow get: if signedIn() && resource.metadata.get('chatSealed', '') == 'true' &&
        chatMediaReadable(threadId, uid, resource.metadata.get('chatMessageId', ''));
      allow list, create, update: if false;
      allow delete: if isOwner(uid) && chatMediaMember(threadId);
    }


    match /admin_broadcasts/{broadcastId}/image.jpg {
      allow read: if true;
      allow create: if signedIn() && request.auth.token.admin == true && request.auth.token.email_verified == true && request.auth.token.email == 'turgutburaktan@gmail.com' && safeImageWrite() && request.resource.contentType == 'image/jpeg' && request.resource.size <= 10 * 1024 * 1024;
      allow update, delete: if false;
    }
    match /route_albums/{planId}/{uid}/{mediaId}/{fileName} {
      function participant() {
        return signedIn() && firestore.get(/databases/(default)/documents/travel_plans/$(planId)).data.memberIds.hasAny([request.auth.uid]);
      }
      allow read: if participant();
      allow create: if participant() && isOwner(uid) && (safeImageWrite() || safeVideoWrite()) &&
        (fileName == 'thumb.jpg' || fileName.matches('media\\.(jpg|png|webp|heic|heif|mp4|mov)'));
      allow update: if false;
      allow delete: if participant() && isOwner(uid);
    }
    match /route_chat/{planId}/{uid}/{messageId}/audio.m4a {
      function participant() {
        return signedIn() && firestore.get(/databases/(default)/documents/travel_plans/$(planId)).data.memberIds.hasAny([request.auth.uid]);
      }
      allow read: if participant();
      allow create: if resource == null && participant() && isOwner(uid) && safeAudioWrite() && request.resource.contentType == 'audio/mp4';
      allow update: if false;
      allow delete: if participant() && isOwner(uid);
    }
    // No un-namespaced uploads are accepted.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}


