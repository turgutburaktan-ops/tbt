rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function safeImageWrite() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 15 * 1024 * 1024 &&
        request.resource.contentType != null &&
        request.resource.contentType.matches('^image/(jpeg|png|webp|heic|heif)$');
    }

    function safeVideoWrite() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 100 * 1024 * 1024 &&
        request.resource.contentType != null &&
        request.resource.contentType.matches('^video/(mp4|quicktime)$');
    }

    function safeMediaWrite() {
      return safeImageWrite() || safeVideoWrite();
    }

    // User media stays namespaced by Firebase Auth uid. This keeps existing
    // public feed/profile rendering intact while preventing cross-account writes.
    // SVG and arbitrary image/video MIME types are intentionally rejected.
    match /users/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isOwner(uid) && safeMediaWrite();
      allow delete: if isOwner(uid);
    }

    // No un-namespaced uploads are accepted.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
