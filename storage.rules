rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function safeImageWrite() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 15 * 1024 * 1024 &&
        request.resource.contentType != null &&
        request.resource.contentType.matches('^image/(jpeg|png|webp|heic|heif)$');
    }

    function safeVideoWrite() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 100 * 1024 * 1024 &&
        request.resource.contentType != null &&
        request.resource.contentType.matches('^video/(mp4|quicktime)$');
    }

    function safeAudioWrite() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 20 * 1024 * 1024 &&
        request.resource.contentType != null &&
        request.resource.contentType.matches('^audio/(mp4|m4a|aac|mpeg|ogg|wav|x-m4a)$');
    }

    function safeMediaWrite() {
      return safeImageWrite() || safeVideoWrite() || safeAudioWrite();
    }

    // User media stays namespaced by Firebase Auth uid. This keeps existing
    // public feed/profile/chat rendering intact while preventing cross-account writes.
    match /users/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isOwner(uid) && safeMediaWrite();
      allow delete: if isOwner(uid);
    }

    match /admin_broadcasts/{broadcastId}/image.jpg {
      allow read: if true;
      allow create: if signedIn() && request.auth.token.admin == true && request.auth.token.email_verified == true && request.auth.token.email == 'turgutburaktan@gmail.com' && safeImageWrite() && request.resource.contentType == 'image/jpeg' && request.resource.size <= 10 * 1024 * 1024;
      allow update, delete: if false;
    }
    match /route_albums/{planId}/{uid}/{mediaId}/{fileName} {
      function participant() {
        return signedIn() && firestore.get(/databases/(default)/documents/travel_plans/$(planId)).data.memberIds.hasAny([request.auth.uid]);
      }
      allow read: if participant();
      allow create: if participant() && isOwner(uid) && (safeImageWrite() || safeVideoWrite()) &&
        (fileName == 'thumb.jpg' || fileName.matches('media\\.(jpg|png|webp|heic|heif|mp4|mov)'));
      allow update: if false;
      allow delete: if participant() && isOwner(uid);
    }
    match /route_chat/{planId}/{uid}/{messageId}/audio.m4a {
      function participant() {
        return signedIn() && firestore.get(/databases/(default)/documents/travel_plans/$(planId)).data.memberIds.hasAny([request.auth.uid]);
      }
      allow read: if participant();
      allow create: if resource == null && participant() && isOwner(uid) && safeAudioWrite() && request.resource.contentType == 'audio/mp4';
      allow update: if false;
      allow delete: if participant() && isOwner(uid);
    }
    // No un-namespaced uploads are accepted.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
